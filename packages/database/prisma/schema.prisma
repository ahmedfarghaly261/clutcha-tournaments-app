generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  ORGANIZER
  CAPTAIN
  TOURNAMENT_STAFF
  REFEREE
  CHECK_IN_STAFF
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RosterType {
  STARTER
  SUBSTITUTE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum EligibilityStatus {
  ELIGIBLE
  INELIGIBLE
  PENDING_REVIEW
}

enum TournamentMode {
  ONLINE
  ONSITE
}

enum TournamentVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  CHECK_IN_OPEN
  IN_PROGRESS
  COMPLETED
  POSTPONED
  CANCELLED
  ARCHIVED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  GROUPS_THEN_PLAYOFFS
  SWISS
  BATTLE_ROYALE
}

enum TournamentSeedingMethod {
  MANUAL
  RANDOM
  RANKED
}

enum GamingRoomPurpose {
  COMPETITION
  PRACTICE
  WARMUP
  FINAL_STAGE
  BACKUP
}

enum TournamentRegistrationStatus {
  PENDING_PAYMENT
  PENDING_APPROVAL
  CONFIRMED
  REJECTED
  WAITLISTED
  WITHDRAWN
  CHECKED_IN
  DISQUALIFIED
  REFUND_PENDING
  REFUNDED
}

enum RegistrationPaymentStatus {
  NOT_REQUIRED
  AWAITING_PROOF
  PROOF_SUBMITTED
  VERIFIED
  REJECTED
  PENDING
  PAID
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum TournamentPaymentMethodType {
  INSTAPAY
  VODAFONE_CASH
  BANK_TRANSFER
  EXTERNAL_LINK
  OTHER
}

enum TournamentPaymentProofStatus {
  SUBMITTED
  VERIFIED
  REJECTED
  SUPERSEDED
}

enum RegistrationApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TournamentMatchStatus {
  SCHEDULED
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
  FORFEIT
}

enum TournamentMatchOfficialResultStatus {
  PENDING
  CONFIRMED
  OVERTURNED
}

enum TournamentMatchForfeitStatus {
  NONE
  TEAM_A
  TEAM_B
  BOTH
}

enum TournamentMatchDisputeStatus {
  NONE
  OPEN
  RESOLVED
  REJECTED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  displayName  String
  role         UserRole
  status       UserStatus @default(PENDING_VERIFICATION)

  phoneNumber     String?
  discordUsername String?

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  captainTeam          Team?                    @relation("TeamCaptain")
  captainRosterPlayer  RosterPlayer?            @relation("CaptainRosterPlayer")
  authSessions         AuthSession[]
  organizerProfile     OrganizerProfile?
  organizedTournaments Tournament[]             @relation("TournamentOrganizer")
  captainRegistrations TournamentRegistration[] @relation("TournamentRegistrationCaptain")
  verifiedPaymentProofs TournamentRegistrationPaymentProof[] @relation("PaymentProofVerifiedBy")
  rejectedPaymentProofs TournamentRegistrationPaymentProof[] @relation("PaymentProofRejectedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@map("users")
}

model Team {
  id               String     @id @default(uuid())
  name             String
  slug             String     @unique
  description      String?
  gameKey          String
  region           String?
  logoUrl          String?
  coverUrl         String?
  discordServerUrl String?
  status           TeamStatus @default(ACTIVE)

  captainId String
  captain   User   @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Restrict)

  rosterPlayers           RosterPlayer[]
  tournamentRegistrations TournamentRegistration[]
  teamAMatches            TournamentMatch[]        @relation("TournamentMatchTeamA")
  teamBMatches            TournamentMatch[]        @relation("TournamentMatchTeamB")
  wonMatches              TournamentMatch[]        @relation("TournamentMatchWinner")
  wonMatchGames           TournamentMatchGame[]    @relation("TournamentMatchGameWinner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([captainId])
  @@index([gameKey])
  @@map("teams")
}

model RosterPlayer {
  id              String  @id @default(uuid())
  gamerTag        String
  realName        String?
  gameAccountId   String
  phoneNumber     String
  email           String?
  discordUsername String?
  rank            String?
  country         String?

  rosterType         RosterType         @default(STARTER)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  eligibilityStatus  EligibilityStatus  @default(PENDING_REVIEW)

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  captainUserId String? @unique @map("captain_user_id")
  captainUser   User?   @relation("CaptainRosterPlayer", fields: [captainUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, gameAccountId])
  @@index([teamId])
  @@map("roster_players")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @db.Text
  tokenVersion     Int       @default(0)
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  userAgent        String?   @db.VarChar(512)
  ipAddress        String?   @db.VarChar(64)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("auth_sessions")
}

model OrganizerProfile {
  id               String  @id @default(uuid())
  userId           String  @unique
  organizationName String?
  logoUrl          String?
  coverUrl         String?
  description      String?
  contactEmail     String?
  supportPhone     String?
  country          String?
  city             String?
  websiteUrl       String?
  facebookUrl      String?
  instagramUrl     String?
  discordUrl       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("organizer_profiles")
}

model Tournament {
  id               String               @id @default(uuid())
  organizerId      String
  name             String
  slug             String               @unique
  shortDescription String?
  description      String?
  logoUrl          String?
  coverUrl         String?
  gameKey          String
  mode             TournamentMode
  visibility       TournamentVisibility @default(PUBLIC)
  status           TournamentStatus     @default(DRAFT)
  format           TournamentFormat

  minimumTeams       Int
  maximumTeams       Int
  minimumStarters    Int
  maximumStarters    Int
  maximumSubstitutes Int @default(0)

  defaultBestOf   Int                     @default(1)
  finalBestOf     Int                     @default(3)
  seedingMethod   TournamentSeedingMethod @default(MANUAL)
  thirdPlaceMatch Boolean                 @default(false)

  requiredGameAccountId Boolean  @default(true)
  allowedRegion         String?
  allowedCountries      String[]
  allowedPlatforms      String[]
  minimumPlayerAge      Int?
  minimumRank           String?
  maximumRank           String?

  registrationFee    Decimal @default(0) @db.Decimal(12, 2)
  currency           String  @default("EGP")
  prizePool          Decimal @default(0) @db.Decimal(12, 2)
  prizeDistribution  Json?
  refundPolicy       String?
  cancellationPolicy String?

  rules                  String
  rulesVersion           String  @default("1.0")
  rosterChangeRules      String?
  checkInRules           String?
  matchReportingRules    String?
  evidenceRequirements   String?
  disputeDeadlineMinutes Int?
  forfeitRules           String?
  codeOfConduct          String?

  registrationOpensAt  DateTime
  registrationClosesAt DateTime
  rosterLocksAt        DateTime?
  checkInOpensAt       DateTime?
  checkInClosesAt      DateTime?
  startsAt             DateTime
  endsAt               DateTime?
  timezone             String    @default("Africa/Cairo")

  waitlistEnabled        Boolean @default(false)
  maximumWaitlistSize    Int?
  manualApprovalRequired Boolean @default(true)

  publishedAt          DateTime?
  registrationOpenedAt DateTime?
  registrationClosedAt DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?

  organizer User @relation("TournamentOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)

  onlineConfiguration TournamentOnlineConfiguration?
  venue               TournamentVenue?
  paymentMethods      TournamentPaymentMethod[]
  registrations       TournamentRegistration[]
  matches             TournamentMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizerId])
  @@index([status])
  @@index([gameKey])
  @@index([mode])
  @@index([visibility])
  @@index([startsAt])
  @@index([registrationClosesAt])
  @@map("tournaments")
}

model TournamentPaymentMethod {
  id           String                      @id @default(uuid())
  tournamentId String
  type         TournamentPaymentMethodType
  displayName  String
  enabled      Boolean                     @default(true)

  accountHolderName String?
  accountIdentifier String?
  phoneNumber       String?
  instapayAddress   String?
  bankName          String?
  bankBranch        String?
  bankAccountNumber String?
  iban              String?
  swiftCode         String?
  externalUrl       String?
  instructions      String
  notes             String?

  tournament Tournament                         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  proofs     TournamentRegistrationPaymentProof[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([enabled])
  @@map("tournament_payment_methods")
}

model TournamentOnlineConfiguration {
  id           String @id @default(uuid())
  tournamentId String @unique

  serverRegion                    String
  publicInstructions              String?
  connectionRules                 String?
  evidenceRequired                Boolean @default(false)
  screenshotRequirements          String?
  resultSubmissionDeadlineMinutes Int?

  discordServerUrl      String?
  captainSupportChannel String?
  matchReportingChannel String?
  lobbyInstructions     String?
  privateSupportContact String?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tournament_online_configurations")
}

model TournamentVenue {
  id               String  @id @default(uuid())
  tournamentId     String  @unique
  name             String
  country          String
  city             String
  address          String
  mapUrl           String?
  checkInLocation  String
  parkingInfo      String?
  spectatorPolicy  String?
  venueRules       String?
  emergencyContact String?

  equipmentProvided Json?
  playersMayBring   Json?
  playersMustBring  Json?

  personalPeripheralsAllowed Boolean @default(false)
  controllersAllowed         Boolean @default(false)
  usbDevicesAllowed          Boolean @default(false)
  driverInstallationAllowed  Boolean @default(false)

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  gamingRooms TournamentGamingRoom[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tournament_venues")
}

model TournamentGamingRoom {
  id           String            @id @default(uuid())
  venueId      String
  name         String
  description  String?
  purpose      GamingRoomPurpose
  stationCount Int

  cpu             String
  gpu             String
  ram             String?
  storage         String?
  operatingSystem String?

  monitorBrand          String?
  monitorModel          String
  monitorSizeInches     Decimal? @db.Decimal(4, 1)
  monitorResolution     String?
  monitorRefreshRateHz  Int
  monitorResponseTimeMs Decimal? @db.Decimal(4, 1)

  mouse      String
  keyboard   String
  headset    String
  mousePad   String?
  controller String?

  internetConnection String?
  equipmentNotes     String?

  venue TournamentVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  tournamentMatches TournamentMatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@map("tournament_gaming_rooms")
}

model TournamentRegistration {
  id           String @id @default(uuid())
  tournamentId String
  teamId       String
  captainId    String

  status         TournamentRegistrationStatus @default(PENDING_APPROVAL)
  paymentStatus  RegistrationPaymentStatus    @default(NOT_REQUIRED)
  approvalStatus RegistrationApprovalStatus   @default(PENDING)

  rosterSnapshot         Json
  captainContactSnapshot Json

  rulesVersion    String
  rulesAcceptedAt DateTime
  submittedAt     DateTime @default(now())

  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  withdrawnAt     DateTime?
  checkedInAt     DateTime?
  disqualifiedAt  DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  team       Team       @relation(fields: [teamId], references: [id], onDelete: Restrict)
  captain    User       @relation("TournamentRegistrationCaptain", fields: [captainId], references: [id], onDelete: Restrict)
  paymentProofs TournamentRegistrationPaymentProof[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tournamentId, teamId])
  @@index([captainId])
  @@index([tournamentId])
  @@index([status])
  @@index([approvalStatus])
  @@index([paymentStatus])
  @@map("tournament_registrations")
}

model TournamentRegistrationPaymentProof {
  id              String                       @id @default(uuid())
  registrationId  String
  paymentMethodId String
  status          TournamentPaymentProofStatus @default(SUBMITTED)

  expectedAmount Decimal @db.Decimal(12, 2)
  currency       String
  proofUrl       String
  originalName   String
  mimeType       String
  fileSize       Int

  transactionReference String?
  paidAt               DateTime?
  captainNote          String?

  submittedAt     DateTime @default(now())
  verifiedAt      DateTime?
  verifiedById    String?
  rejectedAt      DateTime?
  rejectedById    String?
  rejectionReason String?

  registration  TournamentRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  paymentMethod TournamentPaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  verifiedBy    User?                   @relation("PaymentProofVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy    User?                   @relation("PaymentProofRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([paymentMethodId])
  @@index([status])
  @@map("tournament_registration_payment_proofs")
}

model TournamentMatch {
  id           String @id @default(uuid())
  tournamentId String

  stage           String
  round           Int
  bracketPosition String?
  bestOf          Int       @default(1)
  scheduledAt     DateTime?

  teamAId      String?
  teamBId      String?
  winnerTeamId String?

  status               TournamentMatchStatus               @default(SCHEDULED)
  teamAScore           Int?
  teamBScore           Int?
  forfeitStatus        TournamentMatchForfeitStatus        @default(NONE)
  officialResultStatus TournamentMatchOfficialResultStatus @default(PENDING)
  disputeStatus        TournamentMatchDisputeStatus        @default(NONE)

  evidenceUrl      String?
  onlineServerInfo Json?

  gamingRoomId       String?
  onsiteStationLabel String?

  tournament Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamA      Team?                 @relation("TournamentMatchTeamA", fields: [teamAId], references: [id], onDelete: SetNull)
  teamB      Team?                 @relation("TournamentMatchTeamB", fields: [teamBId], references: [id], onDelete: SetNull)
  winnerTeam Team?                 @relation("TournamentMatchWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)
  gamingRoom TournamentGamingRoom? @relation(fields: [gamingRoomId], references: [id], onDelete: SetNull)

  games TournamentMatchGame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tournamentId])
  @@index([teamAId])
  @@index([teamBId])
  @@index([winnerTeamId])
  @@index([status])
  @@index([scheduledAt])
  @@map("tournament_matches")
}

model TournamentMatchGame {
  id      String @id @default(uuid())
  matchId String

  gameNumber Int
  mapName    String?

  teamAScore   Int?
  teamBScore   Int?
  winnerTeamId String?
  evidenceUrl  String?

  match      TournamentMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  winnerTeam Team?           @relation("TournamentMatchGameWinner", fields: [winnerTeamId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, gameNumber])
  @@index([matchId])
  @@index([winnerTeamId])
  @@map("tournament_match_games")
}
